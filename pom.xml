<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.shop</groupId>
    <artifactId>bill-manager</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    
    <name>Distributor Bill Manager</name>
    <description>Real-time bill and payment management system for shops</description>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tomcat.username>admin</tomcat.username>
        <tomcat.password>admin123</tomcat.password>
    </properties>
    
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Generate web.xml automatically -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <webResources>
                        <resource>
                            <directory>src/main/webapp</directory>
                            <filtering>false</filtering>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
            
            <!-- Generate index.html using Maven Antrun Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-webapp"/>
                                <echo file="${project.build.directory}/generated-webapp/index.html">
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
    &lt;title&gt;Distributor Bill Manager&lt;/title&gt;
    &lt;link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"&gt;
    &lt;link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"&gt;
    &lt;style&gt;
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }
        body {
            background: #f1f5f9;
            padding: 24px 20px;
            color: #0f172a;
        }
        .app-container {
            max-width: 1440px;
            margin: 0 auto;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 28px;
            gap: 16px;
        }
        .title h1 {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1e293b, #2d3a4b);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        .card {
            background: white;
            border-radius: 28px;
            padding: 18px 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.02);
            border: 1px solid #e9eef3;
        }
        .card .value {
            font-size: 2rem;
            font-weight: 800;
            color: #0f172a;
        }
        .two-columns {
            display: flex;
            flex-wrap: wrap;
            gap: 28px;
        }
        .form-section {
            flex: 1.2;
            min-width: 280px;
        }
        .table-section {
            flex: 2.2;
            min-width: 340px;
        }
        .form-card {
            background: white;
            border-radius: 28px;
            padding: 24px;
            border: 1px solid #e9eef3;
            position: sticky;
            top: 20px;
        }
        .input-group {
            margin-bottom: 18px;
        }
        .input-group label {
            display: block;
            font-weight: 500;
            font-size: 0.8rem;
            margin-bottom: 6px;
            color: #334155;
        }
        .input-group input, .input-group select {
            width: 100%;
            padding: 12px 14px;
            border-radius: 18px;
            border: 1px solid #cbd5e1;
            font-size: 0.9rem;
        }
        .btn {
            background: #1e293b;
            color: white;
            border: none;
            padding: 12px 18px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .btn-primary {
            background: #2563eb;
        }
        .btn-primary:hover {
            background: #1d4ed8;
        }
        .btn-outline {
            background: transparent;
            border: 1px solid #cbd5e1;
            color: #1e293b;
            margin-top: 12px;
        }
        .table-wrapper {
            background: white;
            border-radius: 28px;
            padding: 4px 0px;
            border: 1px solid #eef2f8;
            overflow-x: auto;
        }
        .bill-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .bill-table th {
            text-align: left;
            padding: 18px 16px;
            background: #fafcff;
            font-weight: 600;
            border-bottom: 1px solid #e2e8f0;
        }
        .bill-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #ecf3f9;
        }
        .status {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .status-paid {
            background: #dff9e6;
            color: #15803d;
        }
        .status-pending {
            background: #ffedd5;
            color: #b45309;
        }
        .status-overdue {
            background: #fee2e2;
            color: #b91c1c;
        }
        .action-icons i {
            margin: 0 5px;
            cursor: pointer;
            font-size: 1.1rem;
            color: #6c7a91;
        }
        .action-icons i:hover {
            color: #2563eb;
        }
        .delete-icon:hover {
            color: #dc2626 !important;
        }
        .filter-bar {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-bottom: 16px;
            gap: 12px;
        }
        .search-box {
            background: white;
            border-radius: 60px;
            padding: 6px 16px;
            border: 1px solid #e2e8f0;
        }
        .search-box input {
            border: none;
            padding: 8px 10px;
            background: transparent;
            outline: none;
            width: 200px;
        }
        @media (max-width: 780px) {
            body { padding: 16px; }
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;div class="app-container"&gt;
    &lt;div class="header"&gt;
        &lt;div class="title"&gt;
            &lt;h1&gt;&lt;i class="fas fa-store"&gt;&lt;/i&gt; Distributor Bill Manager&lt;/h1&gt;
            &lt;p&gt;Track purchase bills, due dates &amp; payments — real-time view&lt;/p&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class="summary-cards" id="summaryCards"&gt;
        &lt;div class="card"&gt;&lt;h3&gt;Total Bills&lt;/h3&gt;&lt;div class="value" id="totalBills"&gt;0&lt;/div&gt;&lt;/div&gt;
        &lt;div class="card"&gt;&lt;h3&gt;Outstanding&lt;/h3&gt;&lt;div class="value" id="totalDue"&gt;₹0&lt;/div&gt;&lt;/div&gt;
        &lt;div class="card"&gt;&lt;h3&gt;Overdue Bills&lt;/h3&gt;&lt;div class="value" id="overdueCount"&gt;0&lt;/div&gt;&lt;/div&gt;
        &lt;div class="card"&gt;&lt;h3&gt;Due within 7 days&lt;/h3&gt;&lt;div class="value" id="dueSoonCount"&gt;0&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;

    &lt;div class="two-columns"&gt;
        &lt;div class="form-section"&gt;
            &lt;div class="form-card"&gt;
                &lt;h2&gt;&lt;i class="fas fa-receipt"&gt;&lt;/i&gt; Add New Bill&lt;/h2&gt;
                &lt;div class="input-group"&gt;
                    &lt;label&gt;Distributor Name&lt;/label&gt;
                    &lt;input type="text" id="distName" placeholder="e.g., Global Distributors"&gt;
                &lt;/div&gt;
                &lt;div class="input-group"&gt;
                    &lt;label&gt;Bill Amount (₹)&lt;/label&gt;
                    &lt;input type="number" id="billAmount" placeholder="0.00"&gt;
                &lt;/div&gt;
                &lt;div class="input-group"&gt;
                    &lt;label&gt;Purchase Date&lt;/label&gt;
                    &lt;input type="date" id="purchaseDate"&gt;
                &lt;/div&gt;
                &lt;div class="input-group"&gt;
                    &lt;label&gt;Payment Terms&lt;/label&gt;
                    &lt;select id="paymentTerms"&gt;
                        &lt;option value="30"&gt;Net 30 (standard)&lt;/option&gt;
                        &lt;option value="15"&gt;Net 15&lt;/option&gt;
                        &lt;option value="45"&gt;Net 45&lt;/option&gt;
                    &lt;/select&gt;
                &lt;/div&gt;
                &lt;button class="btn btn-primary" id="addBillBtn"&gt;&lt;i class="fas fa-plus-circle"&gt;&lt;/i&gt; Add Bill&lt;/button&gt;
                &lt;button class="btn btn-outline" id="demoDataBtn"&gt;&lt;i class="fas fa-chart-simple"&gt;&lt;/i&gt; Load Sample Bills&lt;/button&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;div class="table-section"&gt;
            &lt;div class="filter-bar"&gt;
                &lt;div class="search-box"&gt;
                    &lt;i class="fas fa-search"&gt;&lt;/i&gt;
                    &lt;input type="text" id="searchInput" placeholder="Search distributor..."&gt;
                &lt;/div&gt;
                &lt;select id="filterStatus"&gt;
                    &lt;option value="all"&gt;All bills&lt;/option&gt;
                    &lt;option value="pending"&gt;Pending only&lt;/option&gt;
                    &lt;option value="overdue"&gt;Overdue only&lt;/option&gt;
                    &lt;option value="paid"&gt;Paid only&lt;/option&gt;
                &lt;/select&gt;
            &lt;/div&gt;
            &lt;div class="table-wrapper"&gt;
                &lt;table class="bill-table"&gt;
                    &lt;thead&gt;
                        &lt;tr&gt;&lt;th&gt;Distributor&lt;/th&gt;&lt;th&gt;Amount&lt;/th&gt;&lt;th&gt;Due Date&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Action&lt;/th&gt;&lt;/tr&gt;
                    &lt;/thead&gt;
                    &lt;tbody id="tableBody"&gt;&lt;tr&gt;&lt;td colspan="5"&gt;Loading...&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;
                &lt;/table&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
    let bills = JSON.parse(localStorage.getItem('bills') || '[]');
    
    function saveToLocal() {
        localStorage.setItem('bills', JSON.stringify(bills));
    }
    
    function calculateDueDate(purchaseDate, termsDays) {
        const date = new Date(purchaseDate);
        const due = new Date(date);
        due.setDate(date.getDate() + termsDays);
        return due.toISOString().split('T')[0];
    }
    
    function getStatus(dueDate, isPaid) {
        if (isPaid) return 'paid';
        const today = new Date();
        today.setHours(0,0,0,0);
        const due = new Date(dueDate);
        if (due &lt; today) return 'overdue';
        return 'pending';
    }
    
    function renderUI() {
        const searchTerm = document.getElementById('searchInput')?.value.toLowerCase() || '';
        const filterVal = document.getElementById('filterStatus')?.value || 'all';
        
        let filtered = bills.filter(b => 
            b.distributor.toLowerCase().includes(searchTerm)
        );
        
        if (filterVal !== 'all') {
            filtered = filtered.filter(b => b.status === filterVal);
        }
        
        const tbody = document.getElementById('tableBody');
        if (filtered.length === 0) {
            tbody.innerHTML = '&lt;tr&gt;&lt;td colspan="5"&gt;No bills found&lt;/td&gt;&lt;/tr&gt;';
        } else {
            tbody.innerHTML = filtered.map(bill =&gt; `
                &lt;tr&gt;
                    &lt;td&gt;&lt;strong&gt;${bill.distributor}&lt;/strong&gt;&lt;/td&gt;
                    &lt;td&gt;₹ ${bill.amount.toFixed(2)}&lt;/td&gt;
                    &lt;td&gt;${bill.dueDate}&lt;/td&gt;
                    &lt;td&gt;&lt;span class="status status-${bill.status}"&gt;${bill.status}&lt;/span&gt;&lt;/td&gt;
                    &lt;td class="action-icons"&gt;
                        ${bill.status !== 'paid' ? `&lt;i class="fas fa-check-circle" onclick="markAsPaid(${bill.id})" style="color:#16a34a;"&gt;&lt;/i&gt;` : ''}
                        &lt;i class="fas fa-trash-alt delete-icon" onclick="deleteBill(${bill.id})"&gt;&lt;/i&gt;
                    &lt;/td&gt;
                &lt;/tr&gt;
            `).join('');
        }
        
        const totalBills = bills.length;
        const totalDue = bills.filter(b =&gt; b.status !== 'paid').reduce((sum, b) =&gt; sum + b.amount, 0);
        const overdueCount = bills.filter(b =&gt; b.status === 'overdue').length;
        const today = new Date();
        const weekLater = new Date(today);
        weekLater.setDate(today.getDate() + 7);
        const dueSoonCount = bills.filter(b =&gt; {
            const due = new Date(b.dueDate);
            return b.status !== 'paid' && due &gt;= today && due &lt;= weekLater;
        }).length;
        
        document.getElementById('totalBills').innerText = totalBills;
        document.getElementById('totalDue').innerHTML = `₹ ${totalDue.toFixed(2)}`;
        document.getElementById('overdueCount').innerText = overdueCount;
        document.getElementById('dueSoonCount').innerText = dueSoonCount;
    }
    
    function addBill() {
        const distributor = document.getElementById('distName').value;
        const amount = parseFloat(document.getElementById('billAmount').value);
        const purchaseDate = document.getElementById('purchaseDate').value;
        const termsDays = parseInt(document.getElementById('paymentTerms').value);
        
        if (!distributor || !amount || !purchaseDate) {
            alert('Please fill all fields');
            return;
        }
        
        const dueDate = calculateDueDate(purchaseDate, termsDays);
        const newBill = {
            id: Date.now(),
            distributor: distributor,
            amount: amount,
            purchaseDate: purchaseDate,
            dueDate: dueDate,
            status: 'pending',
            terms: termsDays
        };
        newBill.status = getStatus(dueDate, false);
        bills.push(newBill);
        saveToLocal();
        renderUI();
        
        document.getElementById('distName').value = '';
        document.getElementById('billAmount').value = '';
    }
    
    function markAsPaid(id) {
        const bill = bills.find(b =&gt; b.id === id);
        if (bill) {
            bill.status = 'paid';
            saveToLocal();
            renderUI();
        }
    }
    
    function deleteBill(id) {
        if (confirm('Delete this bill?')) {
            bills = bills.filter(b =&gt; b.id !== id);
            saveToLocal();
            renderUI();
        }
    }
    
    function loadSampleData() {
        bills = [
            { id: 1, distributor: 'Alpha Traders', amount: 12500, purchaseDate: '2026-04-01', dueDate: '2026-05-01', status: 'overdue', terms: 30 },
            { id: 2, distributor: 'Bright Distributors', amount: 8700, purchaseDate: '2026-04-25', dueDate: '2026-05-10', status: 'pending', terms: 15 },
            { id: 3, distributor: 'City Wholesale', amount: 24500, purchaseDate: '2026-05-01', dueDate: '2026-05-31', status: 'pending', terms: 30 },
            { id: 4, distributor: 'Eco Distributor', amount: 3300, purchaseDate: '2026-03-15', dueDate: '2026-04-14', status: 'paid', terms: 30 }
        ];
        saveToLocal();
        renderUI();
    }
    
    document.getElementById('addBillBtn')?.addEventListener('click', addBill);
    document.getElementById('demoDataBtn')?.addEventListener('click', loadSampleData);
    document.getElementById('searchInput')?.addEventListener('input', renderUI);
    document.getElementById('filterStatus')?.addEventListener('change', renderUI);
    
    // Initialize
    if (bills.length === 0) {
        loadSampleData();
    } else {
        renderUI();
    }
    
    // Set default date
    const today = new Date().toISOString().split('T')[0];
    if (document.getElementById('purchaseDate')) {
        document.getElementById('purchaseDate').value = today;
    }
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
                                </echo>
                                <copy todir="${project.build.directory}/${project.build.finalName}">
                                    <fileset dir="${project.build.directory}/generated-webapp"/>
                                </copy>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Deploy to Tomcat -->
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <url>http://localhost:8080/manager/text</url>
                    <server>TomcatServer</server>
                    <path>/bill-manager</path>
                    <username>${tomcat.username}</username>
                    <password>${tomcat.password}</password>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
